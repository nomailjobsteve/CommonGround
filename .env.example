# CommonGround — Environment Variables
#
# Copy this file to .env and fill in the values.
# Do NOT commit your real .env file.

# --- Frontend (safe for browser bundle) ---
# These are public values exposed to the client. They do NOT contain secrets.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# --- Server-side secrets (DO NOT put in .env or client code) ---
# The QLOO_API_KEY must be configured as an edge function secret,
# NOT as a VITE_ environment variable. It is read exclusively by the
# qloo-proxy edge function on the server.
#
# To configure in Supabase, use the dashboard or the Supabase MCP tools.
# Never commit this key to git or expose it in the browser bundle.

# QLOO_API_KEY=your-qloo-api-key-here  # set this as an edge function secret, not in .env
